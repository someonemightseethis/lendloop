# n8n stack environment: copy to n8n/.env and run
#   docker compose --env-file n8n/.env up -d
# Kept apart from the Next.js env so the app never loads n8n's secrets.
# Generate secrets with: openssl rand -hex 32

N8N_ENCRYPTION_KEY=
N8N_DB_PASSWORD=

# One secret per direction. Set the same values on the Convex deployment.
CONVEX_TO_N8N_SECRET=
N8N_TO_CONVEX_SECRET=

# Convex HTTP actions URL as seen from the n8n container:
#   Convex local deployment: http://host.docker.internal:3211
#   Convex cloud:            https://<deployment>.convex.site
CONVEX_SITE_URL=http://host.docker.internal:3211

LENDLOOP_APP_URL=http://localhost:3100
LENDLOOP_MAIL_FROM="LendLoop <noreply@lendloop.local>"
GENERIC_TIMEZONE=UTC

# Public base URL of n8n, if Convex cloud must reach it through a tunnel.
N8N_PUBLIC_URL=http://localhost:5678/
