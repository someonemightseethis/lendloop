# /opt/lendloop-stack/.env  (chmod 600, root). Never commit real values.
# Generate each secret with: openssl rand -hex 32

# Convex: signs admin keys. Changing it invalidates the admin key below.
CONVEX_INSTANCE_SECRET=
# Written after first start: docker compose exec convex ./generate_admin_key.sh
# Keep it in single quotes: the key contains a '|'.
CONVEX_SELF_HOSTED_ADMIN_KEY=

# n8n credential encryption. Losing it means re-entering the SMTP credential.
N8N_ENCRYPTION_KEY=

# One secret per direction; the same values are set on Convex (npx convex env set).
CONVEX_TO_N8N_SECRET=
N8N_TO_CONVEX_SECRET=

LENDLOOP_MAIL_FROM="LendLoop <noreply@lendloop.ahmedrameezaka.com>"
GENERIC_TIMEZONE=UTC
