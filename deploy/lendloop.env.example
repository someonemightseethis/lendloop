# Server-only. Copied to /etc/lendloop.env on first provision (mode 600).
# NEXT_PUBLIC_* values are inlined by `next build`, so edit the file and redeploy.
#
# Convex (from `npx convex dev` / the Convex dashboard):
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
# Clerk Dashboard > API keys:
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
