# Server-only. Copied to /etc/lendloop.env on first provision (mode 600).
# NEXT_PUBLIC_* values are inlined by `next build`, so edit the file and redeploy.
#
# Self-hosted Convex behind nginx (deploy/docker-compose.prod.yml). HTTP actions
# are not public (n8n reaches them on the Docker network), so SITE_URL stays empty.
NEXT_PUBLIC_CONVEX_URL=https://lendloop.ahmedrameezaka.com/convex
NEXT_PUBLIC_CONVEX_SITE_URL=
# Clerk Dashboard > API keys:
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
