# ---------------------------------------------------------------------------
# LendLoop environment. Copy to .env (docker compose) and .env.local (Next.js).
# Never commit real values. Generate secrets with: openssl rand -hex 32
# ---------------------------------------------------------------------------

# --- Next.js (.env.local) ---------------------------------------------------
# Written by `npx convex dev`.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
# Clerk (Dashboard > API keys). Leave empty to use Clerk keyless dev mode.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Convex deployment (set with `npx convex env set NAME value`) ------------
# CLERK_JWT_ISSUER_DOMAIN   Clerk Frontend API URL, e.g. https://your-app.clerk.accounts.dev
# ADMIN_EMAILS              Comma-separated verified emails that get the admin role
# N8N_WEBHOOK_URL           e.g. http://localhost:5678/webhook/lendloop/request-events
# CONVEX_TO_N8N_SECRET      Same value as below; signs Convex -> n8n webhooks
# N8N_TO_CONVEX_SECRET      Same value as below; verifies n8n -> Convex calls

# --- n8n stack (.env, read by docker compose) --------------------------------
N8N_ENCRYPTION_KEY=
N8N_DB_PASSWORD=
# Separate secret per direction.
CONVEX_TO_N8N_SECRET=
N8N_TO_CONVEX_SECRET=
# Convex HTTP actions URL as seen from the n8n container:
#   local Convex deployment: http://host.docker.internal:3211
#   Convex cloud:            https://<deployment>.convex.site
CONVEX_SITE_URL=http://host.docker.internal:3211
LENDLOOP_APP_URL=http://localhost:3100
LENDLOOP_MAIL_FROM="LendLoop <noreply@lendloop.local>"
GENERIC_TIMEZONE=UTC
# Public base URL of n8n if Convex cloud must reach it through a tunnel.
N8N_PUBLIC_URL=http://localhost:5678/
