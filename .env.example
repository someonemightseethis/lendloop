# Next.js environment: copy to .env.local. Never commit real values.

# Written by `npx convex dev`.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Clerk (Dashboard > API keys). Leave both empty to run in Clerk keyless dev mode.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Convex deployment variables are not read from this file. Set them with
# `npx convex env set NAME value` (see README > Environment variables):
#   CLERK_JWT_ISSUER_DOMAIN, ADMIN_EMAILS, N8N_WEBHOOK_URL,
#   CONVEX_TO_N8N_SECRET, N8N_TO_CONVEX_SECRET
